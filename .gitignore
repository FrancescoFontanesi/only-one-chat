# Dependencies
node_modules/

# Build output
dist/
out/
*.vsix
*.tsbuildinfo

# Test artifacts
coverage/
.vscode-test/

# Reference checkouts (fetched by scripts/fetch-references.ps1, never versioned)
references/*
!references/README.md

# Local graft index (optional personal tool, see docs/development.md).
# graft also writes .ignore so ripgrep can still search graft/ locally.
graft/
.graft/
.ignore

# Logs and local state
*.log
.env
.env.*
*.tmp
*.orig

# Tool caches
.pnpm-store/
.eslintcache
.cache/

# Personal agent and tool settings (project rules are documented in docs/)
.claude/
.codex/
CLAUDE.local.md

# Editor: share only what F5, tasks and recommendations need
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.code-workspace

# OS
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
*.swp

# Python caches of the sandbox scenarios (reference implementations)
__pycache__/
