{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/apps/vscode", "--disable-extensions"],
      "outFiles": ["${workspaceFolder}/apps/vscode/dist/**/*.js"],
      "preLaunchTask": "build"
    },
    {
      "name": "Run Extension Tests",
      "type": "extensionHost",
      "request": "launch",
      "testConfiguration": "${workspaceFolder}/apps/vscode/.vscode-test.mjs",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/apps/vscode", "--disable-extensions"],
      "outFiles": ["${workspaceFolder}/apps/vscode/out/test/**/*.js"],
      "preLaunchTask": "build tests"
    }
  ]
}
