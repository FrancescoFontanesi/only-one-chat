{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "pnpm build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "build tests",
      "type": "shell",
      "command": "pnpm --filter agent-workspace exec node esbuild.mjs --tests",
      "problemMatcher": []
    },
    {
      "label": "watch",
      "type": "shell",
      "command": "pnpm --filter agent-workspace run watch",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "check",
      "type": "shell",
      "command": "pnpm check",
      "group": "test",
      "problemMatcher": ["$tsc"]
    }
  ]
}
