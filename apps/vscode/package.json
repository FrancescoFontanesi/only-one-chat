{
  "name": "only-one-chat",
  "displayName": "Only One Chat",
  "description": "Coordinate multiple AI coding agents through one shared conversation.",
  "version": "0.0.1",
  "publisher": "francesco-fontanesi",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FrancescoFontanesi/only-one-chat"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In an untrusted folder the panel opens, but no agent runs.",
      "restrictedConfigurations": [
        "onlyOneChat.codexPath",
        "onlyOneChat.claudePath",
        "onlyOneChat.allowedCommands",
        "onlyOneChat.verifyCommand"
      ]
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "onlyOneChat.openPanel",
        "title": "Open Panel",
        "category": "Only One Chat"
      }
    ],
    "configuration": {
      "title": "Only One Chat",
      "properties": {
        "onlyOneChat.leader.cli": {
          "type": "string",
          "enum": [
            "codex",
            "claude"
          ],
          "default": "codex",
          "description": "CLI of the leader, the model you chat with."
        },
        "onlyOneChat.leader.model": {
          "type": "string",
          "default": "gpt-6.1-sol",
          "description": "Model of the leader, as its CLI names it."
        },
        "onlyOneChat.leader.effort": {
          "type": "string",
          "default": "low",
          "description": "Reasoning effort of the leader."
        },
        "onlyOneChat.implementer.cli": {
          "type": "string",
          "enum": [
            "codex",
            "claude"
          ],
          "default": "claude",
          "description": "CLI of the implementer, which takes the larger changes."
        },
        "onlyOneChat.implementer.model": {
          "type": "string",
          "default": "sonnet",
          "description": "Model of the implementer, as its CLI names it."
        },
        "onlyOneChat.implementer.effort": {
          "type": "string",
          "default": "low",
          "description": "Reasoning effort of the implementer."
        },
        "onlyOneChat.subagents.codexModel": {
          "type": "string",
          "default": "gpt-6-luna",
          "description": "Model of Codex's own sub-agents."
        },
        "onlyOneChat.subagents.claudeModel": {
          "type": "string",
          "default": "claude-haiku-5-5",
          "description": "Model of Claude's own sub-agents."
        },
        "onlyOneChat.subagents.effort": {
          "type": "string",
          "default": "low",
          "description": "Reasoning effort of the sub-agents."
        },
        "onlyOneChat.approvalMode": {
          "type": "string",
          "enum": [
            "manual",
            "auto"
          ],
          "default": "manual",
          "description": "manual: you approve each message between agents; auto: they pass, logged."
        },
        "onlyOneChat.leaderReview": {
          "type": "string",
          "enum": [
            "always",
            "deferred"
          ],
          "default": "always",
          "description": "After a delegation: always, the leader reviews the report at once; deferred, it reads it with your next message (one leader turn less)."
        },
        "onlyOneChat.codexPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Path of the Codex executable; empty: searched on PATH."
        },
        "onlyOneChat.claudePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Path of the Claude Code executable; empty: searched on PATH."
        },
        "onlyOneChat.allowedCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "python",
            "py"
          ],
          "scope": "machine",
          "description": "Programs Claude may run without asking, for example to run the tests."
        },
        "onlyOneChat.verifyCommand": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine",
          "description": "Run again by the extension after each delegation, e.g. [\"python\", \"-m\", \"unittest\"]."
        },
        "onlyOneChat.fake": {
          "type": "boolean",
          "default": false,
          "description": "Development host only: fake CLIs, no model turns, no quota."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p webview/tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "test:e2e": "node esbuild.mjs --tests && vscode-test",
    "package": "node esbuild.mjs --production && vsce package --no-dependencies"
  },
  "dependencies": {
    "@only-one-chat/adapters": "workspace:*",
    "@only-one-chat/runtime": "workspace:*",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/vscode": "1.140.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2"
  }
}
