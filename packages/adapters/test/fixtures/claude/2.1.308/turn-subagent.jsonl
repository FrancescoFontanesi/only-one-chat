{"type":"message","dir":"server","atMs":8058,"message":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0191a18JCASM1yucifkzeSnR","type":"tool_result","content":"1\t// Environment for the CLIs the adapters launch: the user's own, minus the\n2\t// variables that would make a CLI bill an API key instead of the user's\n3\t// subscription. Base URLs and proxies pass on purpose: the user's local tools\n4\t// (Headroom, for example) depend on them. See docs/decisions/0006.\n5\t\n6\t/** Removed from every child environment, whatever their case. */\n7\texport const API_KEY_VARIABLES: readonly string[] = [\n8\t  'OPENAI_API_KEY',\n9\t  'CODEX_API_KEY',\n10\t  'CODEX_ACCESS_TOKEN',\n11\t  'ANTHROPIC_API_KEY',\n12\t  'ANTHROPIC_AUTH_TOKEN',\n13\t  'GEMINI_API_KEY',\n14\t  'GOOGLE_API_KEY',\n15\t];\n16\t\n17\tconst KEYS = new Set(API_KEY_VARIABLES);\n18\t\n19\texport function withoutApiKeys(env: NodeJS.ProcessEnv): NodeJS.ProcessEnv {\n20\t  const out: NodeJS.ProcessEnv = {};\n21\t  for (const [name, value] of Object.entries(env)) {\n22\t    if (value !== undefined && !KEYS.has(name.toUpperCase())) out[name] = value;\n23\t  }\n24\t  return out;\n25\t}\n26\t\n27\t/** Looks a variable up the way Windows does, ignoring case. */\n28\texport function getEnv(env: NodeJS.ProcessEnv, name: string): string | undefined {\n29\t  const key = Object.keys(env).find((candidate) => candidate.toUpperCase() === name.toUpperCase());\n30\t  return key === undefined ? undefined : env[key];\n31\t}\n32\t"}]},"parent_tool_use_id":"toolu_01S6DpE6xyR9sryLm3G2Zfrp","agent_id":"a89c2a708551017cf","session_id":"<session-id-1>","uuid":"<uuid-14>","timestamp":"2026-10-25T22:40:19.578Z","tool_result_meta":[{"id":"toolu_0191a18JCASM1yucifkzeSnR","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"haiku-file-reader","task_description":"Leggi environment.ts e trova variabili"}}
