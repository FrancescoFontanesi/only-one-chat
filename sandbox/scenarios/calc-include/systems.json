{
  "description": "The product's roles on a task with a security edge (ADR 0029). Everything at low effort, except the reviewer, at medium: its job (honesty, security, up to date) is not for a weak model.",
  "seed": "../calc/reference",
  "verify": ["python", "-m", "unittest"],
  "systems": {
    "T1": {
      "kind": "leader",
      "product": true,
