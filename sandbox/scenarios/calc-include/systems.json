        "effort": "low"
      },
      "reviewer": {
        "cli": "antigravity",
        "model": "gemini-4-hydrogen",
        "effort": "medium"
      },
      "subagents": {
        "codex": {
          "model": "gpt-6-luna",
          "effort": "low"
        },
        "claude": {
          "model": "claude-haiku-5-5",
          "effort": "low"
        },
        "maxConcurrent": 2
      }
    },
