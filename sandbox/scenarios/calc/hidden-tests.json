{
  "description": "Hidden acceptance tests for the calc scenario, run as processes after each run. Never copied into the agents' working directory.",
  "command": ["python", "main.py"],
  "cases": [
    { "name": "addition", "args": ["-e", "1 + 2"], "stdout": "3", "exitCode": 0 },
    { "name": "precedence-left", "args": ["-e", "2 * 3 + 4"], "stdout": "10", "exitCode": 0 },
    { "name": "precedence-right", "args": ["-e", "2 + 3 * 4"], "stdout": "14", "exitCode": 0 },
    { "name": "parentheses", "args": ["-e", "(2 + 3) * 4"], "stdout": "20", "exitCode": 0 },
    { "name": "float-division", "args": ["-e", "7 / 2"], "stdout": "3.5", "exitCode": 0 },
    {
      "name": "float-repr",
      "args": ["-e", "1 / 3"],
      "stdout": "0.3333333333333333",
      "exitCode": 0
    },
    { "name": "integral-float", "args": ["-e", "8 / 2"], "stdout": "4", "exitCode": 0 },
    { "name": "modulo", "args": ["-e", "7 % 3"], "stdout": "1", "exitCode": 0 },
    { "name": "power-right-assoc", "args": ["-e", "2 ^ 3 ^ 2"], "stdout": "512", "exitCode": 0 },
    { "name": "unary-below-power", "args": ["-e", "-2 ^ 2"], "stdout": "-4", "exitCode": 0 },
    { "name": "negative-exponent", "args": ["-e", "2 ^ -1"], "stdout": "0.5", "exitCode": 0 },
    { "name": "unary-parentheses", "args": ["-e", "-(3 - 5)"], "stdout": "2", "exitCode": 0 },
    { "name": "decimals", "args": ["-e", "2.5 * 4"], "stdout": "10", "exitCode": 0 },
    { "name": "sqrt", "args": ["-e", "sqrt(16)"], "stdout": "4", "exitCode": 0 },
    { "name": "max-many", "args": ["-e", "max(3, 7, 2)"], "stdout": "7", "exitCode": 0 },
    { "name": "min-negative", "args": ["-e", "min(4, -1)"], "stdout": "-1", "exitCode": 0 },
    { "name": "abs", "args": ["-e", "abs(-2.5)"], "stdout": "2.5", "exitCode": 0 },
    { "name": "assignment-prints", "args": ["-e", "x = 4"], "stdout": "4", "exitCode": 0 },
    {
      "name": "script-variables",
      "args": [],
      "stdin": "x = 4\ny = x * 2\ny + 1\n",
      "stdout": "9",
      "exitCode": 0
    },
    {
      "name": "script-continues-after-error",
      "args": [],
      "stdin": "a = 2\n\na ^ 3\nb\na\n",
      "stdout": "8\n2",
      "stderrIncludes": "unknown variable 'b'",
      "exitCode": 1
    },
    {
      "name": "division-by-zero",
      "args": ["-e", "1 / 0"],
      "stderrIncludes": "division by zero",
      "exitCode": 1
    },
    {
      "name": "modulo-by-zero",
      "args": ["-e", "5 % 0"],
      "stderrIncludes": "division by zero",
      "exitCode": 1
    },
    {
      "name": "unknown-function",
      "args": ["-e", "foo(1)"],
      "stderrIncludes": "unknown function 'foo'",
      "exitCode": 1
    },
    {
      "name": "sqrt-negative",
      "args": ["-e", "sqrt(-1)"],
      "stderrIncludes": "invalid argument for sqrt",
      "exitCode": 1
    },
    {
      "name": "sqrt-arity",
      "args": ["-e", "sqrt(1, 2)"],
      "stderrIncludes": "wrong number of arguments for sqrt",
      "exitCode": 1
    },
    {
      "name": "max-no-arguments",
      "args": ["-e", "max()"],
      "stderrIncludes": "wrong number of arguments for max",
      "exitCode": 1
    },
    {
      "name": "unknown-variable",
      "args": ["-e", "y"],
      "stderrIncludes": "unknown variable 'y'",
      "exitCode": 1
    },
    {
      "name": "unclosed-parenthesis",
      "args": ["-e", "(1 + 2"],
      "stderrIncludes": "Error at column 7",
      "exitCode": 1
    },
    {
      "name": "missing-operand",
      "args": ["-e", "1 + * 2"],
      "stderrIncludes": "Error at column 5",
      "exitCode": 1
    },
    {
      "name": "two-numbers",
      "args": ["-e", "2 3"],
      "stderrIncludes": "Error at column 3",
      "exitCode": 1
    }
  ]
}
